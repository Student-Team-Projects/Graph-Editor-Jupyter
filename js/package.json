{
  "name": "graph-editor-jupyter-widget",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/widget.ts --bundle --format=esm --minify --outdir=../src/graph_editor_jupyter/static",
    "dev": "esbuild src/widget.ts --bundle --format=esm --sourcemap=inline --outdir=../src/graph_editor_jupyter/static --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/forces.test.ts --bundle --platform=node --format=esm --outfile=.test/forces.test.mjs --log-level=warning && node --test .test/"
  },
  "devDependencies": {
    "@anywidget/types": "0.4.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "d3-force": "3.0.0"
  }
}
